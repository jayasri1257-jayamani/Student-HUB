.chart{position:relative;height:300px}.bad{color:var(--d);font-weight:700}.mid{color:var(--w);font-weight:700}.good{color:var(--ok);font-weight:700}
#chatBtn{position:fixed;bottom:28px;right:28px;width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,var(--p),var(--s));color:#fff;font-size:26px;padding:0;z-index:999}
#chatWin{position:fixed;bottom:98px;right:28px;width:340px;height:460px;background:#fff;border-radius:12px;box-shadow:0 5px 40px #0004;display:none;flex-direction:column;z-index:999}
#chatWin.on{display:flex}.ch{background:linear-gradient(135deg,var(--p),var(--s));color:#fff;padding:14px;border-radius:12px 12px 0 0;font-weight:600;display:flex;justify-content:space-between}.ch button{background:none;color:#fff;padding:0 6px;font-size:20px}
#msgs{flex:1;overflow-y:auto;padding:14px}.m{margin-bottom:10px;padding:9px 12px;border-radius:6px;font-size:.9em;line-height:1.4}.m.user{background:var(--l);margin-left:30px;text-align:right}.m.bot{background:#e3f2fd;color:var(--i);margin-right:30px}.ci{display:flex;gap:8px;padding:12px;border-top:1px solid var(--b)}.ci button{padding:9px 14px;background:var(--p);color:#fff}
.locator{background:var(--bg);color:var(--tx);border:1px solid var(--bd);border-radius:14px;padding:18px}
.locator h2{color:var(--ac)}.locator input,.locator select{background:var(--bg);color:var(--tx);border:1px solid var(--bd)}
.ctl{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.ctl label{font-size:12px;color:var(--mu);display:flex;align-items:center;gap:6px}
