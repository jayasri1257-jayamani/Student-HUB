.scene{position:relative;width:250px;height:110px;transform-style:preserve-3d;transform:rotateX(58deg) rotateZ(var(--rz,-35deg))}
.slab{position:absolute;inset:0;transform-style:preserve-3d;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:auto 1fr;gap:6px;padding:6px;background:#7882962e;border:1px solid var(--bd);border-radius:8px}
.tile{display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;border-radius:6px;cursor:pointer;color:#fff;box-shadow:0 3px 0 #0004}
.tile.f{background:#16a05a}.tile.b{background:#d64336}.tile.sel{outline:3px solid #fff;box-shadow:0 0 14px 3px var(--ac)}.tile.cl{outline:3px dashed #7c74ff}
.fl{grid-column:1/-1;font-size:10px;color:var(--mu)}.leg{font-size:12px;color:var(--mu);margin:6px 0}.lbl{font-size:13px;color:var(--mu);margin-top:8px}.cd{font:700 36px/1.1 ui-monospace,Menlo,monospace;margin:2px 0 8px}.acts{margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}.wa{background:#1fa855;color:#fff;text-decoration:none;padding:10px 14px;border-radius:10px;font-weight:700}
.lgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}.rm{border:1px solid var(--bd);border-radius:12px;padding:10px;background:var(--card)}.rm.f{border-left:4px solid var(--free)}.rm.b{border-left:4px solid var(--busy)}.h{display:flex;justify-content:space-between;align-items:center;gap:6px}.pill{font-size:11px;font-weight:700;padding:2px 8px;border-radius:99px}.f .pill{background:var(--fb);color:var(--free)}.b .pill{background:var(--bb);color:var(--busy)}.u{font-size:13px;margin:6px 0}.tag{display:inline-block;font-size:11px;padding:2px 7px;border-radius:99px;border:1px solid var(--bd);color:var(--mu);margin-right:4px}.tl{position:relative;height:8px;background:var(--fb);border-radius:4px;margin-top:6px;overflow:hidden}.tl i{position:absolute;top:0;bottom:0;background:var(--busy);opacity:.75}.tl b{position:absolute;top:-2px;bottom:-2px;width:2px;background:var(--tx)}.ax{display:flex;justify-content:space-between;font-size:10px;color:var(--mu)}.fh{display:flex;justify-content:space-between;align-items:baseline;margin:18px 0 8px}.fh span{color:var(--mu);font-size:13px}.note{color:var(--mu);font-size:13px;margin:6px 0}.chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.chips button{font-size:12px;padding:5px 9px;color:var(--mu)}
@media(max-width:768px){.grid2,.row{grid-template-columns:1fr}header h1{font-size:1.9em}#chatWin{width:90%;right:5%}}
</style>
</head>
<body>
<div class="container">
<header><div class="badge-inst">🏫 SRM Institute of Science and Technology - Tiruchirappalli</div><h1>📚 Attendance Predictor</h1><p>Attendance calculator + analytics + free classroom locator</p></header>

<div class="nav">
<button class="active" data-tab="calc">📊 Calculator</button><button data-tab="analytics">📈 Analytics</button><button data-tab="sim">📅 Leave Simulator</button><button data-tab="locator">🏫 Free Class Locator</button><button data-tab="guide">ℹ️ Guide</button>
</div>

<div class="tab active" id="tab-calc">
<div class="grid2">
<div class="card"><h2>📋 Your Information</h2>
<div class="fg"><label>Section (optional)</label><select id="section"><option value="">-- Choose your section --</option><option>II BME</option><option>II ECE-DS A</option><option>II ECE-DS B</option><option>III ECE-A</option><option>III ECE-B</option><option>III ECE-DS</option><option>III BME</option><option>IV ECE-A</option><option>IV ECE-B</option></select></div>
<div class="row"><div class="fg"><label>Total classes / semester</label><input id="total" value="45" readonly></div><div class="fg"><label>Classes remaining</label><input id="left" readonly></div></div>
<div class="row"><div class="fg"><label>Classes conducted</label><input type="number" id="conducted" min="1" max="45" oninput="livePct()"></div><div class="fg"><label>Classes attended</label><input type="number" id="attended" min="0" oninput="livePct()"></div></div>
<div class="fg"><label>Current attendance %</label><input id="pct" readonly></div>
<div class="btns"><button class="bp" onclick="calculate()">🔍 Calculate Now</button><button class="bs" onclick="resetAll()">Reset</button></div></div>

<div class="card"><h2>📊 Results</h2><div id="alerts"></div><div id="none" style="text-align:center;color:#999;padding:40px 10px">👈 Enter your details and calculate</div>
<div id="results" style="display:none"><div class="stats"><div class="stat"><b id="s-rem">--</b><span>CLASSES LEFT</span></div><div class="stat"><b id="s-cur">--</b><span>CURRENT %</span></div><div class="stat"><b id="s-max">--</b><span>MAX POSSIBLE %</span></div></div>
<div class="rbox"><h4>⚠️ To stay safe (75%)</h4><div class="rval" id="res-75">--</div><div class="rsub" id="sub-75"></div><div class="bar"><div class="fill" id="bar-75"></div></div></div>
<div class="rbox"><h4>🎯 To reach excellence (90%)</h4><div class="rval" id="res-90">--</div><div class="rsub" id="sub-90"></div><div class="bar"><div class="fill" id="bar-90"></div></div></div></div></div></div>
<div class="card"><h2>📈 Detailed Analysis</h2><div id="analysis"><p style="color:#999">Results will appear here.</p></div></div>
<div class="card"><h2>📊 Attendance Visualization</h2><div class="chart"><canvas id="barChart"></canvas></div></div>
</div>

<div class="tab" id="tab-analytics"><div class="card"><h2>📈 Attendance Health Dashboard</h2><div class="stats"><div class="stat"><b id="a-pct">0%</b><span>CURRENT ATTENDANCE</span></div><div class="stat"><b id="a-att">0</b><span>ATTENDED</span></div><div class="stat"><b id="a-miss">0</b><span>MISSED SO FAR</span></div><div class="stat"><b id="a-stat">--</b><span>STATUS</span></div></div><div class="chart"><canvas id="pieChart"></canvas></div></div></div>

<div class="tab" id="tab-sim"><div class="card"><h2>📅 Leave & OD Simulator</h2><p style="color:#666;margin-bottom:16px">Run the calculator first, then test future absences.</p><div class="row"><div class="fg"><label>Future classes you will miss</label><input type="number" id="sim-miss" min="0" value="0" oninput="simulate()"></div><div class="fg"><label>OD / approved (counted present)</label><input type="number" id="sim-od" min="0" value="0" oninput="simulate()"></div></div><div class="info" id="sim-out">Run the calculator first.</div></div></div>

<div class="tab" id="tab-locator"><div class="locator">
<h2>🏫 Free Class Locator</h2><p class="sub">Find empty rooms from the timetable. Green = free, red = class scheduled.</p>
<div class="card"><strong>Ask in plain English</strong><div class="ai" style="margin-top:8px"><input id="q" placeholder="AC room on ground floor for 2 hours"><button class="p" id="go">Find rooms</button></div><div class="chips" id="ex"></div><div class="res" id="res"></div></div>
<h2>3D building map</h2><div class="ctl"><select id="day"></select><input type="time" id="tm"><button id="now">Now</button><label>Rotate <input type="range" id="rot" min="-70" max="20" value="-35"></label></div>
<div class="leg">Ground floor at the bottom. Green = free, red = class scheduled. Tap a room.</div><div class="stage"><div class="scene" id="scene"></div></div><div class="card" id="panel" style="margin-top:10px"></div>
<h2>Floor grid</h2><div id="floors"></div><p class="note">AC, capacity and floor are timetable-based assumptions.</p>
</div></div>

<div class="tab" id="tab-guide"><div class="card"><h2>ℹ️ How the numbers work</h2><div class="info"><b>Current attendance</b> = attended ÷ conducted × 100</div><div class="info"><b>Classes remaining</b> = 45 − conducted</div><div class="info"><b>75% target</b> = 34 attended classes. <b>90% target</b> = 41 attended classes.</div></div></div>
</div>

<button id="chatBtn" onclick="toggleChat()">💬</button><div id="chatWin"><div class="ch"><span>Attendance Advisor 🤖</span><button onclick="toggleChat()">×</button></div><div id="msgs"></div><div class="ci"><input id="chatIn" placeholder="what if I miss 5 classes?" onkeypress="if(event.key==='Enter')sendChat()"><button onclick="sendChat()">Send</button></div></div>

<script>
const TOTAL=45,$=id=>document.getElementById(id),S={c:0,a:0,charts:{}};
const target=p=>Math.ceil(TOTAL*p/100),needed=(p,a)=>Math.max(0,target(p)-a);
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');$('tab-'+b.dataset.tab).classList.add('active');if(b.dataset.tab==='analytics')renderAnalytics();if(b.dataset.tab==='sim')simulate();if(b.dataset.tab==='locator')locatorSync();});
function livePct(){let c=+$('conducted').value,a=+$('attended').value;$('pct').value=c>0&&a>=0&&a<=c?(a/c*100).toFixed(2)+'%':'';$('left').value=$('conducted').value!==''&&c<=TOTAL?TOTAL-c:''}
function msg(t,type){$('alerts').innerHTML=`<div class="alert alert-${type}">${t}</div>`}
function calculate(){let c=parseInt($('conducted').value),a=parseInt($('attended').value);if(isNaN(c)||c<1||c>TOTAL)return msg('Classes conducted must be between 1 and 45.','danger');if(isNaN(a)||a<0||a>c)return msg('Classes attended must be between 0 and classes conducted.','danger');S.c=c;S.a=a;let rem=TOTAL-c,pct=a/c*100,max=(a+rem)/TOTAL*100;let goal=p=>{let n=needed(p,a);return{n,t:target(p),ok:n<=rem,skip:rem-n}},r75=goal(75),r90=goal(90);msg(!r75.ok?`🚨 75% is not reachable. Best possible final attendance: ${max.toFixed(1)}%.`:r75.n===0?'✅ 75% already secured.':`⚠️ Attend at least ${r75.n} of ${rem} remaining classes to finish at 75% or above.`,!r75.ok?'danger':r75.n===0?'success':'warning');$('none').style.display='none';$('results').style.display='block';$('s-rem').textContent=rem;$('s-cur').textContent=pct.toFixed(1)+'%';$('s-max').textContent=max.toFixed(1)+'%';fill(75,r75,rem,max);fill(90,r90,rem,max);$('analysis').innerHTML=`<div class="info"><p><b>Total:</b> ${TOTAL}</p><p><b>Conducted:</b> ${c} &nbsp; <b>Attended:</b> ${a} &nbsp; <b>Missed:</b> ${c-a}</p><p><b>Current:</b> ${pct.toFixed(2)}%</p><p><b>Remaining:</b> ${rem}</p><p><b>Best possible:</b> ${max.toFixed(2)}%</p><hr style="margin:12px 0;border:0;border-top:1px solid var(--b)"><p><b>75%:</b> ${r75.n===0?'Already secured':r75.ok?'Attend '+r75.n+' of '+rem+' remaining; can miss '+r75.skip:'Not reachable'}</p><p><b>90%:</b> ${r90.n===0?'Already secured':r90.ok?'Attend '+r90.n+' of '+rem+' remaining; can miss '+r90.skip:'Not reachable'}</p></div>`;drawBar(pct,r75,r90,rem);simulate()}
function fill(p,r,rem,max){$('res-'+p).textContent=r.n===0?'✅ Secured':r.ok?r.n+' classes':'❌ Not reachable';$('sub-'+p).textContent=r.n===0?`Already at ${r.t}/${TOTAL} needed`:r.ok?`Attend ${r.n} of ${rem}; can miss ${r.skip}`:`Short by ${r.n-rem} (max ${max.toFixed(1)}%)`;$('bar-'+p).style.width=(r.n===0?0:r.ok?r.n/rem*100:100)+'%'}
function resetAll(){['conducted','attended','pct','left','section'].forEach(id=>$(id).value='');$('results').style.display='none';$('none').style.display='block';$('alerts').innerHTML='';$('analysis').innerHTML='<p style="color:#999">Results will appear here.</p>';S.c=S.a=0;Object.values(S.charts).forEach(x=>x&&x.destroy());S.charts={};simulate()}
function drawBar(p,r75,r90,rem){if(S.charts.bar)S.charts.bar.destroy();let sh=r=>rem?Math.min(100,r.n/rem*100):0;S.charts.bar=new Chart($('barChart'),{type:'bar',data:{labels:['Current attendance %','% remaining for 75%','% remaining for 90%'],datasets:[{data:[p,sh(r75),sh(r90)],backgroundColor:['#667eea','#f57c00','#388e3c'],borderRadius:8}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,max:100,ticks:{stepSize:10}}}}})}
function renderAnalytics(){if(!S.c)return;let p=S.a/S.c*100,rem=TOTAL-S.c;$('a-pct').textContent=p.toFixed(1)+'%';$('a-att').textContent=S.a;$('a-miss').textContent=S.c-S.a;$('a-stat').textContent=p<75?'At Risk':p>=90?'Excellent':'On Track';if(S.charts.pie)S.charts.pie.destroy();S.charts.pie=new Chart($('pieChart'),{type:'doughnut',data:{labels:['Attended','Missed','Remaining'],datasets:[{data:[S.a,S.c-S.a,rem],backgroundColor:['#667eea','#d32f2f','#e0e0e0']}]},options:{responsive:true,maintainAspectRatio:false}})}
function simulate(){let o=$('sim-out');if(!S.c){o.textContent='Run the calculator first.';return}let rem=TOTAL-S.c,m=Math.min(Math.max(0,+$('sim-miss').value||0),rem),od=Math.min(Math.max(0,+$('sim-od').value||0),m),fa=S.a+rem-m+od,p=fa/TOTAL*100;o.innerHTML=`<p><b>Remaining:</b> ${rem} &nbsp; <b>Missing:</b> ${m} &nbsp; <b>OD:</b> ${od}</p><p><b>Final attendance:</b> <span class="${p<75?'bad':p<90?'mid':'good'}">${p.toFixed(2)}%</span></p>`}
const chat=[{r:'bot',t:'Hi! 👋 Ask me "how many classes for 90%?" or "what if I miss 5 classes?"'}];function drawChat(){$('msgs').innerHTML=chat.map(m=>`<div class="m ${m.r}">${m.t}</div>`).join('');$('msgs').scrollTop=$('msgs').scrollHeight}function toggleChat(){$('chatWin').classList.toggle('on');drawChat()}function sendChat(){let q=$('chatIn').value.trim();if(!q)return;$('chatIn').value='';chat.push({r:'user',t:q.replace(/</g,'&lt;')});drawChat();setTimeout(()=>{chat.push({r:'bot',t:reply(q.toLowerCase())});drawChat()},300)}function reply(q){if(!S.c)return'Enter your classes conducted and attended, then click Calculate.';let rem=TOTAL-S.c,p=S.a/S.c*100,num=(q.match(/\d+/)||[])[0];if(num&&/(miss|leave|skip|bunk|absent)/.test(q)){let m=Math.min(+num,rem),fp=(S.a+rem-m)/TOTAL*100;return`If you miss ${m} remaining classes, final attendance is ${fp.toFixed(1)}%.`}if(q.includes('90')){let n=needed(90,S.a);return n>rem?`90% is not reachable; you need ${n} more classes and only ${rem} remain.`:`For 90%, attend ${n} of ${rem} remaining classes.`}let n=needed(75,S.a);return n>rem?`75% is not reachable; you need ${n} more classes.`:`You are at ${p.toFixed(1)}%. For 75%, attend ${n} of ${rem} remaining classes.`}drawChat();

/* FREE CLASS LOCATOR */
const P=[0,[540,590],[590,640],[650,700],[700,750],[750,800],[800,850],[850,900],[910,960],[960,1010]],DAYS=['Monday','Tuesday','Wednesday','Thursday','Friday'],FL=['Ground floor','1st floor','2nd floor','3rd floor','4th floor','5th floor'];
const R={'108':['IST 108 Lab',0,'lab',1,40],'107':['IST 107 Lab',0,'lab',1,40],'TB106':['TB-106',0,'classroom',0,40],'211':['IST 211',1,'classroom',0,60],'225':['IST 225',1,'classroom',0,60],'227':['IST 227',1,'classroom',0,60],'309':['IST 309 Lab',2,'lab',1,40],'401':['IST 401',3,'classroom',0,60],'411':['IST 411',3,'classroom',0,60],'416':['IST 416',3,'classroom',0,60],'518':['IST 518',4,'classroom',1,60],'519':['IST 519',4,'classroom',1,60],'602':['IST 602',5,'classroom',1,60],'625':['IST 625',5,'classroom',1,60]};
const B=[];const add=(rooms,days,p1,p2)=>rooms.split(',').forEach(r=>[...days].forEach(d=>B.push([r,+d,P[p1][0],P[p2][1]])));
a
