.nav button:hover,.nav button.active{background:#fff;color:var(--p)}
.tab{display:none}.tab.active{display:block}
.card{background:#fff;border-radius:12px;padding:28px;box-shadow:0 10px 30px #0002;margin-bottom:22px}
.card h2{color:var(--p);margin-bottom:18px;font-size:1.5em}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.fg{margin-bottom:16px}
label{display:block;margin-bottom:6px;font-weight:600;color:var(--t)}
input,select{width:100%;padding:11px;border:2px solid var(--b);border-radius:6px;font-size:1em;font-family:inherit}
input:focus,select:focus{outline:none;border-color:var(--p)}
input[readonly]{background:var(--l);color:#555}
.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
button{padding:12px 22px;border:none;border-radius:6px;font-size:1em;font-weight:600;cursor:pointer}
.btns{display:flex;gap:12px;margin-top:16px}.bp{background:linear-gradient(135deg,var(--p),var(--s));color:#fff;flex:1}.bs{background:var(--l);color:var(--t)}
.alert{padding:14px 18px;border-radius:8px;margin-bottom:16px;border-left:4px solid;line-height:1.5}
.alert-danger{background:#ffe5e5;border-color:var(--d);color:#b71c1c}.alert-warning{background:#fff3e0;border-color:var(--w);color:#e65100}.alert-success{background:#e8f5e9;border-color:var(--ok);color:#1b5e20}.alert-info{background:#e3f2fd;border-color:var(--i);color:#0d47a1}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:14px;margin-bottom:20px}
.stat{background:var(--l);padding:16px;border-radius:8px;text-align:center;border:1px solid var(--b)}
.stat b{display:block;font-size:1.8em;color:var(--p)}.stat span{font-size:.75em;color:#888;font-weight:600}
.rbox{padding:18px;border-radius:8px;margin-bottom:14px;border-left:4px solid var(--p);background:#fafafa}
.rbox h4{margin-bottom:8px}.rval{font-size:2em;font-weight:700;color:var(--p)}.rsub{font-size:.85em;color:#666;margin:4px 0 10px}
.bar{background:var(--b);height:12px;border-radius:6px;overflow:hidden}.fill{height:100%;width:0;background:linear-gradient(90deg,var(--p),var(--s));transition:width .4s}
