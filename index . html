<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--p:#667eea;--s:#764ba2;--d:#d32f2f;--w:#f57c00;--ok:#388e3c;--i:#1976d2;--b:#e0e0e0;--l:#f5f5f5;--t:#333;--bg:#f5f6f9;--card:#fff;--tx:#1a1d23;--mu:#667085;--bd:#e3e6ec;--free:#0b8a4a;--fb:#e5f6ec;--busy:#c5372c;--bb:#fdecea;--ac:#4f46e5}
body{font-family:'Segoe UI',Tahoma,sans-serif;background:linear-gradient(135deg,var(--p),var(--s));min-height:100vh;padding:20px;color:var(--t)}
.container{max-width:1400px;margin:auto}
